{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/entry.js",
  "types": "./dist/entry.d.ts",
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "require": "./dist/entry.js",
      "types": "./dist/entry.d.ts"
    },
    "./base": {
      "import": "./dist/base.js",
      "require": "./dist/base.js",
      "types": "./dist/base.d.ts"
    },
    "./nest": {
      "import": "./dist/nest.js",
      "require": "./dist/nest.js",
      "types": "./dist/nest.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "require": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    }
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc"
  }
}
