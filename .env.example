# Reference for every env var this project uses — see docs/RUNBOOK.md section 2 for
# what each one is for. This file is committed; actual values go in gitignored
# .env.local files (apps/api/.env.local, apps/web/.env.local), never here.
#
# Local dev status of each var is noted inline. Copy what's relevant into the
# matching app's .env.local.

# --- Database (apps/api) ---
# Local dev: docker compose up -d, then this connects to it directly.
# Before deploy: replace with a Neon dev branch connection string (docs/RUNBOOK.md section 5).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meal_tracker

# --- Cloudflare R2 (apps/api) ---
# Not wired up yet — leave blank until the photo upload feature is built (ADR-007).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Slack (apps/api) ---
# Not wired up yet — leave blank until the digest delivery feature is built (ADR-008).
SLACK_BOT_TOKEN=

# --- Admin (apps/api) ---
# Local dev: any value works, this just gates /admin/* (ADR-004).
ADMIN_PASSWORD=dev-local-admin-password

# --- Sentry (apps/api, apps/web) ---
# Not wired up yet — leave blank until the observability step is built.
SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN_FRONTEND=

# --- GitHub Actions only (repo secret, not a local env var) ---
# DIGEST_ENDPOINT_URL points the hourly workflow at the deployed /cron/send-daily-digest.
