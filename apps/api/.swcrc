[
  {
    "$schema": "https://swc.rs/schema.json",
    "test": "\\.mts$",
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "decorators": true
      },
      "transform": {
        "legacyDecorator": true,
        "decoratorMetadata": true
      },
      "target": "es2022"
    },
    "module": {
      "type": "es6"
    },
    "sourceMaps": true
  },
  {
    "$schema": "https://swc.rs/schema.json",
    "exclude": "\\.mts$",
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "decorators": true
      },
      "transform": {
        "legacyDecorator": true,
        "decoratorMetadata": true
      },
      "target": "es2022"
    },
    "module": {
      "type": "commonjs"
    },
    "sourceMaps": true
  }
]
